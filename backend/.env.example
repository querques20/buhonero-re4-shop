# Copiá este archivo como .env y completá los valores

# Puerto donde escucha la API
PORT=3000

# Clave con la que se firman los JWT (poné cualquier string largo)
SECRET_KEY=clavemuysecreta

# Conexión a MongoDB.
# Local con Docker:  mongodb://localhost:27017/buhonero
# Atlas (nube):      mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net/buhonero
URI_DB=mongodb://localhost:27017/buhonero

# Contraseña del usuario admin que se crea solo (admin@buhonero.com).
# Si no la definís queda la de por defecto: buhonero123
# ADMIN_PASSWORD=otra-password
